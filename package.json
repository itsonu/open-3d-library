{
  "name": "open-3d-library",
  "version": "0.1.0",
  "description": "Local-first three.js 3D asset viewer",
  "type": "module",
  "license": "MIT",
  "repository": "github:itsonu/open-3d-library",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run build && python3 serve.py",
    "start:local": "npm run build && python3 serve.py --assets public/assets --local-assets local-assets",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "catalog": "python3 serve.py --write-catalog public/catalog.json",
    "test:unit": "node --test tests/",
    "test:py": "python3 -m unittest discover -s tests",
    "check:private": "node scripts/check-no-private.mjs",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run check:private && npm run test:unit && npm run test:py"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "^8.3.4"
  }
}
