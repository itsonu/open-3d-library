# track only the library code; assets and caches stay out of git
/*
!/.gitignore
!/index.html
!/package.json
!/package-lock.json
!/vite.config.js
!/src/
!/src/**
!/public/
!/public/**
!/tests/
!/tests/**
!/serve.py
!/README.md
!/vendor/
!/vendor/**
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/docs/
!/docs/**
# dependencies and build output
node_modules/
dist/
!/ASSETS.md
