# track only the library code; assets and caches stay out of git
/*
# private local collection: never commit
/local-assets/
!/.gitignore
!/index.html
!/package.json
!/package-lock.json
!/vite.config.js
!/src/
!/src/**
!/public/
!/public/**
!/tests/
!/tests/**
!/serve.py
!/README.md
!/vendor/
!/vendor/**
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/docs/
!/docs/**
!/.github/
!/.github/**
!/.claude/
!/.claude/**
!/scripts/
!/scripts/**
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/CHANGELOG.md
# dependencies and build output
node_modules/
dist/
!/ASSETS.md
